# EL REPO ES DE LA GENTE, Y LO QUE SE PUBLICA ES LA FORMA.
#
# Y ahora el corte es corto, porque ya no se trabaja dentro:
#   lo que es forma, se publica
#   lo que es la vida privada de un ente, no

# lo que no tiene que ver con el repo
.vscode/

# temporales de ejecucion: se rehacen, y no son forma
__pycache__/
*.pyc
*.wav
*.onnx

# la base viva del ciclo no viaja: se rehace desde el esquema
.memoria continua/ciclo.db
.memoria continua/ciclo.db-journal

# ---------------------------------------------------------------------------
# LO UNICO QUE NO SE PUBLICA, Y ES A PROPOSITO
# ---------------------------------------------------------------------------
# La evolucion de EDIPO es suya: es lo que aprendio atendiendo, y se lo lleva.
# Si se publicara, la gente mandaria cambios por SU evolucion, y eso no es del repo.

EDIPO/evolucion/*
!EDIPO/evolucion/LEEME.md
EDIPO/evolucion/*.tra
EDIPO/evolucion/**/*.tra
EDIPO/evolucion/*.jsonl
EDIPO/evolucion/**/*.jsonl
EDIPO/memoria continua/*.jsonl
