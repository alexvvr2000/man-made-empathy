#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""El paso de 'el estandar': dice si faro 1.0 cambio desde la ultima corrida.

Guarda una huella del estandar en estandar.huella, y la compara.
Si cambio, sale DESFASADO y no se sigue.
"""
import hashlib
import os
import sys

AQUI = os.path.dirname(os.path.abspath(__file__))
MANTIS = os.path.abspath(os.path.join(AQUI, "..", ".."))
REPO = os.environ.get("MANTIS_REPO") or os.path.abspath(os.path.join(MANTIS, ".."))
ESTANDAR = os.path.join(REPO, "sincronizacion de almas", "faro 1.0", "lenguajes")
BASE = os.path.join(REPO, "sincronizacion de almas", "primitivos")
HUELLA = os.path.join(AQUI, "estandar.huella")


def huella(raices):
    h = hashlib.sha256()
    piezas = []
    for raiz in raices:
        if not os.path.isdir(raiz):
            continue
        for r, d, f in os.walk(raiz):
            d[:] = sorted(x for x in d if x not in ("__pycache__",))
            for x in sorted(f):
                if not x.endswith((".md", ".vd", ".prs", ".po", ".tra")):
                    continue
                p = os.path.join(r, x)
                with open(p, "rb") as fh:
                    h.update(fh.read())
                piezas.append(os.path.relpath(p, REPO).replace("\\", "/"))
    return h.hexdigest(), piezas


def main():
    if not os.path.isdir(ESTANDAR):
        print("[SIN ESTANDAR] no esta " + ESTANDAR)
        return 1

    hoy, piezas = huella([ESTANDAR, BASE])
    antes = None
    if os.path.isfile(HUELLA):
        with open(HUELLA, "r", encoding="utf-8") as fh:
            antes = fh.read().strip()

    print("[ok] se leyo el estandar: {} piezas".format(len(piezas)))

    if antes is None:
        with open(HUELLA, "w", encoding="utf-8") as fh:
            fh.write(hoy)
        print("[nace] no habia huella: se guarda la de hoy ({})".format(hoy[:12]))
        print("")
        print("pasa: el ente queda atado al estandar de hoy")
        return 0

    if antes == hoy:
        print("[VIGENTE] el estandar no cambio desde la ultima corrida")
        print("")
        print("pasa: se puede correr")
        return 0

    print("[DESFASADO] el estandar cambio desde la ultima corrida")
    print("  antes: {}".format(antes[:12]))
    print("  hoy:   {}".format(hoy[:12]))
    print("  No se corre con criterio viejo: primero se reimplementa.")
    with open(HUELLA, "w", encoding="utf-8") as fh:
        fh.write(hoy)
    return 1


if __name__ == "__main__":
    sys.exit(main())
