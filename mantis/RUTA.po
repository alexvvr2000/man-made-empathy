# RUTA del mundo DSH — el piso donde mantis corre en esta PC
#
# Las cinco claves del RUTA, para ESTE mundo: DeepSeek Harness sobre Windows.
# Lo que este mundo tiene, y lo que no. Lo que no, se declara en Falta.
#
msgid ""
msgstr ""
"rige: RUTA.md\n"
"mundo: DeepSeek Harness en una PC de escritorio\n"
"Escribe: el que preparo el mundo\n"

msgid "RUTA"
msgstr "DeepSeek Harness: un agente que abre archivos, corre la terminal y lee git, en una sola maquina"

msgid "Procesos"
msgstr "ejecu.py corre los .prs de mantis/folders/: el cero, los candados, la tesis y la memoria"

msgid "Falta"
msgstr "no hay ejecucion entre turnos: un folder corre cuando se pide, y no se queda vigilando"

msgid "Escribe"
msgstr "el que preparo el mundo: la autoridad, en esta maquina"

msgid "Se gasta"
msgstr "cambiar de modelo, de PC o de entorno: entonces este RUTA no aplica y se lee el del mundo nuevo"

# Lo que este mundo puede, y lo que no.
msgid "archivos"
msgstr "leer, escribir y mover archivos del repositorio"

msgid "terminal"
msgstr "correr python, git y powershell"

msgid "git"
msgstr "el historial, y la vuelta a un tag"

msgid "memoria"
msgstr "el rastro de mantis, en texto, dentro del repo"

msgid "web"
msgstr "consultar, con costo: una consulta cuenta"

msgid "sin_fondo"
msgstr "no hay proceso en segundo plano entre turnos: lo que no se corre ahora, no corre solo"

msgid "sin_sync"
msgstr "la memoria no se sincroniza sola entre maquinas: viaja en el repo"

# Y la regla que hace al alma transportable en este mundo.
msgid "se_muda"
msgstr "el alma es la memoria: el rastro se lleva al mundo siguiente, y el ejecutor se vuelve a escribir o a encontrar"
